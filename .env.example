# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_website_monitor
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Settings
APP_NAME="Website Monitoring System"
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Kuala_Lumpur

# Security & Cron Key (Change this in production)
CRON_SECRET_KEY=monitor_cron_secret_2026

# Optional: Base URL override (Leave empty for automatic URL detection)
# BASE_URL=http://localhost/monitoring_alert_system
BASE_URL=
